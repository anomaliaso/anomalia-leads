{
  "name": "anomalia-leads",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:keys": "supabase status -o env",
    "db:test": "docker exec -i supabase_db_anomalia-leads psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/tests/billing.sql",
    "core:pull": "git subtree pull --prefix=packages/leads-core https://github.com/anomaliaso/anomalia.git leads-core-dist --squash"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "ai": "^7.0.87",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.4.0",
    "shadcn-svelte": "^1.5.1",
    "supabase": "^2.116.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
