# Supabase
PUBLIC_SUPABASE_URL=http://localhost:8000
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Il modello. Stringa "provider/model" via OpenRouter.
OPENROUTER_API_KEY=
LEADS_MODEL=openai/gpt-5.6-luna

# Il gateway di scraping per Reddit/Threads/X/LinkedIn (leads-core lo riceve iniettato).
SCRAPECREATORS_API_KEY=

# Feed personale di Reddit (reddit.com/prefs/feeds): senza, gli RSS restano anonimi e da
# server prendono 403.
REDDIT_FEED_TOKEN=
REDDIT_FEED_USER=

# Protegge /api/scan quando lo chiama il cron.
CRON_SECRET=
